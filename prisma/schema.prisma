// Prisma 7: the connection URL lives in prisma.config.ts, not here.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SignatureStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Metadata only. The PNG bytes live in the storage adapter, found via `storageKey`.
model Signature {
  id         String          @id @default(uuid()) @db.Uuid
  /// Opaque key inside the storage backend, e.g. "signatures/<uuid>.png". Never a filesystem path.
  storageKey String          @unique
  status     SignatureStatus @default(PENDING)
  /// Intrinsic pixel size of the PNG: the poster layout engine needs it for aspect ratio.
  width      Int
  height     Int
  byteSize   Int
  /// SHA-256 of the stored bytes (integrity check / duplicate detection later).
  sha256     String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  /// Serves "approved, oldest first" pagination: filter on status, then order by (createdAt, id).
  @@index([status, createdAt, id])
}
