# Copy to .env.local and adjust. Never commit real secrets.

# PostgreSQL connection string (Docker: `docker compose up -d db`, or `scripts/local-postgres.sh start`).
DATABASE_URL="postgresql://csitan:csitan@localhost:5544/csitan_dashain?schema=public"

# Where signature PNGs are stored. "local" writes to STORAGE_DIR: fine for development and a single
# server with a persistent disk. It is NOT durable on serverless/ephemeral hosts (see README).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Production safety latch: the app refuses to start with local storage in production unless this is "true".
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# Shared secret for approving/rejecting signatures (x-admin-token header). Use a long random value in production.
ADMIN_TOKEN=change-me-admin

# true = a submitted signature appears on the poster immediately (admins can still reject it in /admin).
# false = it waits as PENDING until an admin approves it.
AUTO_APPROVE_SIGNATURES=true

# Submissions allowed per IP per minute (default 5).
# SUBMIT_RATE_LIMIT_MAX=5
