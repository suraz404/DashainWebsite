import { type Rect } from "@/lib/poster/config";
import { DEFAULT_COMPOSITION_CONFIG, assertValidConfig } from "./config";
import { expandRect, intersectionArea, rectArea, rectGap, rotatedBounds, rotatedExtent } from "./geometry";
import { hash32, mulberry32, unit } from "./random";
import type {
  CompositionConfig, CompositionResult, Placement, PlacementQuality, RegionName, SignatureInput,
  UnplacedSignature,
} from "./types";

const EPS = 1e-6;
const MAX_ASPECT = 12; // 12:1 or 1:12 and beyond is treated as invalid, not as a signature

interface Candidate {
  region: RegionName;
  cx: number;
  cy: number;
  w: number;
  h: number;
  rotation: number;
  scale: number;
  bounds: Rect;
  overlapArea: number;
  clearance: number;
}

/** Region rectangle shrunk on the sides that touch the poster edge. */
function usableRect(region: Rect, c: CompositionConfig): Rect {
  const l = region.x <= EPS ? c.posterEdgeInset : 0;
  const t = region.y <= EPS ? c.posterEdgeInset : 0;
  const r = region.x + region.width >= c.poster.width - EPS ? c.posterEdgeInset : 0;
  const b = region.y + region.height >= c.poster.height - EPS ? c.posterEdgeInset : 0;
  return { x: region.x + l, y: region.y + t, width: region.width - l - r, height: region.height - t - b };
}

/**
 * Deterministic signature composition. Pure: no DOM, no I/O, no Math.random(), no mutation of inputs.
 *
 * Algorithm (greedy, oldest first):
 *  1. Validate; sort by (sequence, id) so input array order is irrelevant; dedupe ids.
 *  2. For each signature, derive size (scale ∈ [minScale,1]) and rotation (±maxRotationDeg) from hash(id).
 *  3. Tier 1 "clean": try regions from least to most crowded (density = covered area ÷ usable area). In each,
 *     try ≤ maxAttemptsPerRegion seeded candidate centres; keep those whose rotated bounding box lies inside
 *     the region, outside the (expanded) protected region and ≥ minGap from every placed box; take the one
 *     with the most clearance. First region that yields one wins.
 *  4. Tier 2 "clean, smallest": same at minScale (more room).
 *  5. Tier 3 "crowded": same search but minGap is waived and overlap is allowed; pick the lowest-overlap candidate across all
 *     regions if overlap ≤ maxOverlapRatio × own area.
 *  6. Otherwise → `unplaced` with reason "no-space" (returned, never dropped).
 *
 * Guarantees: bounding boxes (which contain the rotated image) stay inside their region and outside the
 * protected region; tier 1–2 boxes never overlap and keep minGap. NOT guaranteed: that a free spot is found
 * when one exists (the search is a bounded random sample). Because each signature depends only on those
 * placed before it, the first k placements are identical whether or not later signatures exist.
 */
export function composeSignatures(
  inputs: readonly SignatureInput[],
  config: CompositionConfig = DEFAULT_COMPOSITION_CONFIG,
): CompositionResult {
  assertValidConfig(config);
  const unplaced: UnplacedSignature[] = [];

  // --- 1. validate, canonical order, dedupe -------------------------------------------------
  const sorted = [...inputs].sort(
    (a, b) => (a.sequence ?? 0) - (b.sequence ?? 0) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0),
  );
  const seen = new Set<string>();
  const queue: SignatureInput[] = [];
  for (const s of sorted) {
    if (typeof s.id !== "string" || s.id === "") {
      unplaced.push({ id: String(s.id ?? ""), src: s.src, reason: "invalid-id" });
    } else if (seen.has(s.id)) {
      unplaced.push({ id: s.id, src: s.src, reason: "duplicate-id" });
    } else {
      seen.add(s.id);
      const aspect = s.naturalWidth / s.naturalHeight;
      const ok =
        Number.isFinite(aspect) && s.naturalWidth > 0 && s.naturalHeight > 0 &&
        aspect <= MAX_ASPECT && aspect >= 1 / MAX_ASPECT;
      if (ok) queue.push(s);
      else unplaced.push({ id: s.id, src: s.src, reason: "invalid-geometry" });
    }
  }

  // --- 2. static geometry -------------------------------------------------------------------
  const regionNames = Object.keys(config.regions).sort(); // sorted: independent of object key order
  const usable = Object.fromEntries(regionNames.map((n) => [n, usableRect(config.regions[n]!, config)]));
  const usableArea = Object.fromEntries(regionNames.map((n) => [n, Math.max(rectArea(usable[n]!), EPS)]));
  const keepOut = expandRect(config.protectedRegion, config.protectedInset);
  const covered: Record<RegionName, number> = Object.fromEntries(regionNames.map((n) => [n, 0]));

  // Distances beyond this don't make a spot "better". Relative to the signature size so the layout is
  // identical at any poster resolution (an absolute cap would break scale-independence).
  const clearanceCap = config.maxWidth * 0.75;
  const placed: Placement[] = [];

  /** Sizes the signature for a region; null if it cannot fit there at ≥ minScale. */
  function fit(s: SignatureInput, scale: number, rotation: number, area: Rect) {
    const aspect = s.naturalWidth / s.naturalHeight;
    let w = Math.min(config.maxWidth * scale, config.maxHeight * scale * aspect);
    let h = w / aspect;
    const e = rotatedExtent(w, h, rotation);
    const k = Math.min(1, area.width / e.width, area.height / e.height);
    w *= k;
    h *= k;
    const finalScale = Math.max(w / config.maxWidth, h / config.maxHeight);
    return finalScale + EPS < config.minScale ? null : { w, h, scale: finalScale };
  }

  /** Best candidate in one region for the given tier, or null. */
  function search(s: SignatureInput, tier: 1 | 2 | 3, region: RegionName): Candidate | null {
    const area = usable[region]!;
    const rotation = (unit(`${s.id}|rot`) * 2 - 1) * config.maxRotationDeg;
    const baseScale = tier === 1 ? config.minScale + (1 - config.minScale) * unit(`${s.id}|size`) : config.minScale;
    const size = fit(s, baseScale, rotation, area);
    if (!size) return null;

    const e = rotatedExtent(size.w, size.h, rotation);
    const rng = mulberry32(hash32(`${s.id}|t${tier}|${region}`));
    const spanX = Math.max(area.width - e.width, 0);
    const spanY = Math.max(area.height - e.height, 0);
    let best: Candidate | null = null;

    for (let attempt = 0; attempt < config.maxAttemptsPerRegion; attempt++) {
      const cx = area.x + e.width / 2 + spanX * rng();
      const cy = area.y + e.height / 2 + spanY * rng();
      const bounds = rotatedBounds(cx, cy, size.w, size.h, rotation);
      if (intersectionArea(bounds, keepOut) > 0) continue; // hard constraint, every tier

      // Reject as early as possible: most candidates fail on the first neighbour they touch, so
      // bailing out here (instead of scanning all placed boxes) is what keeps crowded posters fast.
      const ownArea = rectArea(bounds);
      let overlapArea = 0;
      let clearance = clearanceCap;
      let rejected = false;
      for (const p of placed) {
        if (tier < 3) {
          const gap = rectGap(bounds, p.bounds);
          if (gap < config.minGap) { rejected = true; break; } // overlap implies gap 0 < minGap
          if (gap < clearance) clearance = gap;
        } else {
          overlapArea += intersectionArea(bounds, p.bounds);
          if (overlapArea > config.maxOverlapRatio * ownArea + EPS) { rejected = true; break; }
          if (best && overlapArea >= best.overlapArea - EPS) { rejected = true; break; } // can't beat best
        }
      }
      if (rejected) continue;

      const better = !best || tier === 3 || clearance > best.clearance; // tier 3: survivors already beat best
      if (better) {
        best = { region, cx, cy, w: size.w, h: size.h, rotation, scale: size.scale, bounds, overlapArea, clearance };
      }
    }
    return best;
  }

  const density = (r: RegionName) => covered[r]! / usableArea[r]!;

  function place(s: SignatureInput): Placement | null {
    // Least-crowded region first keeps the four sides balanced; hash breaks exact ties stably.
    const order = [...regionNames].sort(
      (a, b) => density(a) - density(b) || hash32(`${s.id}|${a}`) - hash32(`${s.id}|${b}`),
    );
    for (const tier of [1, 2] as const) {
      for (const region of order) {
        const c = search(s, tier, region);
        if (c) return finish(s, c, "clean");
      }
    }
    let best: Candidate | null = null;
    for (const region of order) {
      const c = search(s, 3, region);
      if (c && (!best || c.overlapArea < best.overlapArea)) best = c;
    }
    if (best && best.overlapArea <= config.maxOverlapRatio * rectArea(best.bounds) + EPS) {
      return finish(s, best, "crowded");
    }
    return null;
  }

  function finish(s: SignatureInput, c: Candidate, quality: PlacementQuality): Placement {
    const { width: PW, height: PH } = config.poster;
    const x = c.cx - c.w / 2;
    const y = c.cy - c.h / 2;
    covered[c.region] = covered[c.region]! + rectArea(c.bounds);
    if (quality === "crowded") {
      // Tier 3 skips clearance during search; compute it once for the winner.
      c.clearance = placed.reduce((m, p) => Math.min(m, rectGap(c.bounds, p.bounds)), clearanceCap);
    }
    return {
      id: s.id,
      src: s.src,
      region: c.region,
      x, y, width: c.w, height: c.h,
      rotation: c.rotation,
      bounds: c.bounds,
      normalized: { left: x / PW, top: y / PH, width: c.w / PW, height: c.h / PH },
      layout: {
        quality,
        scale: c.scale,
        clearance: c.clearance,
        overlapRatio: Math.min(c.overlapArea / rectArea(c.bounds), 1),
      },
    };
  }

  // --- 3. place oldest first ----------------------------------------------------------------
  for (const s of queue) {
    const p = place(s);
    if (p) placed.push(p);
    else unplaced.push({ id: s.id, src: s.src, reason: "no-space" });
  }

  const regionCounts = Object.fromEntries(regionNames.map((n) => [n, 0])) as Record<RegionName, number>;
  for (const p of placed) regionCounts[p.region] = (regionCounts[p.region] ?? 0) + 1;
  const crowded = placed.filter((p) => p.layout.quality === "crowded").length;

  return {
    placements: placed,
    unplaced,
    stats: {
      total: inputs.length,
      placed: placed.length,
      clean: placed.length - crowded,
      crowded,
      unplaced: unplaced.length,
      regionCounts,
    },
  };
}
